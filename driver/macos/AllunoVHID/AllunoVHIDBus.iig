#ifndef AllunoVHIDBus_h
#define AllunoVHIDBus_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>

class AllunoVHIDDevice;

class AllunoVHIDBus : public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient** userClient) override;

    kern_return_t plug(const uint8_t* request, size_t length, uint32_t* slot, void* owner) LOCALONLY;
    kern_return_t unplug(uint32_t slot, void* owner) LOCALONLY;
    kern_return_t input(uint32_t slot, const uint8_t* report, uint16_t length, void* owner) LOCALONLY;
    kern_return_t setFeature(uint32_t slot, const uint8_t* report, uint16_t length, void* owner) LOCALONLY;
    kern_return_t pollOutput(uint32_t slot, uint8_t* out, size_t capacity, size_t* written, void* owner) LOCALONLY;
    void unplugOwned(void* owner) LOCALONLY;
};

#endif
